+  score: number;
+  className: string;
+  textClassName: string;
+}
+
+function CompetencyBar({
+  label,
+  score,
+  className,
+  textClassName,
+}: CompetencyBarProps) {
+  const safeScore =
+    Math.min(
+      100,
+      Math.max(
+        0,
+        Number.isFinite(score)
+          ? score
+          : 0,
+      ),
+    );
+
+  return (
+    <div>
+      <div className="flex justify-between gap-3 font-semibold mb-1">
+        <span className="text-slate-700">
+          {label}
+        </span>
+
+        <span
+          className={`font-mono ${textClassName}`}
+        >
+          {safeScore}/100
+        </span>
+      </div>
+
+      <div className="h-2 rounded-full bg-slate-100 overflow-hidden">
+        <div
+          style={{
+            width: `${safeScore}%`,
+          }}
+          className={`h-full ${className}`}
+        />
+      </div>
+    </div>
+  );
+}
